# Copy to .env and fill in. NEVER commit .env.

# Shared secret Express sends in the X-API-Key header (same value as the backend's FACE_VERIFICATION_KEY)
FACE_VERIFICATION_KEY=change-me-long-random-string

# Fernet key used to encrypt face templates.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TEMPLATE_ENCRYPTION_KEY=change-me-generate-with-command-above

# Optional tuning (defaults shown)
PORT=5001
MATCH_THRESHOLD=0.363
DETECTION_SCORE_THRESHOLD=0.8
MIN_FACE_PX=80
MIN_SHARPNESS=20
RATE_LIMIT_PER_MINUTE=120
