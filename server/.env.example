# ==================================
# AD TECH Intern Manager - Backend
# ==================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/intern-manager

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_here_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Frontend
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Face Verification Service (Soham's ai-service/). Base URL only — this backend
# appends /v1/register and /v1/verify. FACE_VERIFICATION_KEY must be the exact
# same value as FACE_VERIFICATION_KEY in ai-service/.env. See ai-service/README.md.
FACE_VERIFICATION_URL=http://127.0.0.1:5001
FACE_VERIFICATION_KEY=your_face_verification_api_key_here
FACE_VERIFICATION_ENABLED=false

# Attendance System
ATTENDANCE_SYSTEM_ACTIVE=false
OFFICIAL_ATTENDANCE_START_DATE=2026-10-01

# Session Configuration
SESSION_INTERVAL_SECONDS=30
MAX_OFFICIAL_SECONDS=28800
VERIFICATION_INTERVAL_MINUTES=30
