# Copy to .env. NEVER commit .env.

PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Where the Python face service runs, and its shared secret (same value as ai-service/.env)
FACE_VERIFICATION_URL=http://127.0.0.1:5001
FACE_VERIFICATION_KEY=change-me

# Demo-friendly timings (real defaults: interval 1800, window 300, target 28800)
VERIFICATION_INTERVAL_SECONDS=30
VERIFICATION_WINDOW_SECONDS=120
VERIFICATION_MAX_ATTEMPTS=3
SESSION_TARGET_SECONDS=28800

ATTENDANCE_SYSTEM_ACTIVE=true
# Lets you fast-forward the clock from the demo. Never enable on a real backend.
MOCK_DEV_ROUTES=true
